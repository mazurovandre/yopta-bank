{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "outDir": "../../dist/apps/user-service",
    "paths": {
      "@auth/*": ["apps/user-service/src/auth/*"],
      "@configs/*": ["apps/user-service/src/configs/*"],
      "@features/*": ["apps/user-service/src/features/*"],
      "@libs/token/*": ["libs/token/src/*"],
      "@common/*": ["common/*"]
    }
  },
  "include": ["src/**/*", "../../common/**/*.d.ts", "jest.config.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
